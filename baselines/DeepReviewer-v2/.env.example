# LLM runtime (Claude Agent SDK)
AGENT_MODEL=claude-opus-4-7
AGENT_RESUME_ATTEMPTS=2

# Offline parsed paper text. The submitted PDF stem must match a .txt file here.
PARSED_PAPERS_DIR=~/review_agent/iclr2026_new/papers

# Internet/external retrieval is disabled for offline review runs.
PAPER_SEARCH_ENABLED=false
PAPER_SEARCH_PROVIDER=offline
MIN_PAPER_SEARCH_CALLS_FOR_PDF_ANNOTATE=0
MIN_PAPER_SEARCH_CALLS_FOR_FINAL=0
MIN_DISTINCT_PAPER_QUERIES_FOR_FINAL=0

# Final report gates
MIN_ANNOTATIONS_FOR_FINAL=10
MIN_ENGLISH_WORDS_FOR_FINAL=0
MIN_CHINESE_CHARS_FOR_FINAL=0
FORCE_ENGLISH_OUTPUT=true
UI_LANGUAGE=en

# Submit behavior
SUBMIT_DEFAULT_WAIT_SECONDS=8
SUBMIT_POLL_INTERVAL_SECONDS=1
MAX_PDF_BYTES=52428800
