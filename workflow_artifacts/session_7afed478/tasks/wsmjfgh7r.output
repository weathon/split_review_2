      "reliable": 1,
      "error_type": "",
      "justification": "Section 4.2's 'Theoretical Basis' only qualitatively invokes PSR and states the approximation in Equation 8 without any proof, consistent with the reviewer's critique.",
      "status": "ok"
    },
